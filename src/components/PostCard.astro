---
import type { Post } from "../lib/posts";
import { formatDate, readingTime } from "../lib/posts";

interface Props { post: Post; }
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="post-card">
  <a href={`${base}posts/${post.id}/`}>
    <div class="meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <span>·</span>
      <span>{readingTime(post.body)} 分钟阅读</span>
    </div>
    <h2>{post.data.title}</h2>
    {post.data.description && <p>{post.data.description}</p>}
    <div class="tags">
      {post.data.tags.map((tag) => <span>#{tag}</span>)}
    </div>
  </a>
</article>

<style>
  .post-card { border: 1px solid var(--line); border-radius: 2px; background: color-mix(in srgb, var(--paper-soft) 42%, transparent); transition: border-color 160ms ease, background-color 160ms ease; }
  .post-card + .post-card { margin-top: 10px; }
  .post-card:hover { border-color: var(--accent); background: var(--accent-soft); }
  a { display: block; padding: 18px 20px 20px; }
  .meta { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 0.76rem; }
  h2 { margin: 7px 0 0; font-family: var(--serif); font-size: clamp(1.2rem, 2.2vw, 1.55rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.35; overflow-wrap: anywhere; }
  p { max-width: 44rem; margin: 6px 0 0; color: var(--muted); font-size: 0.92rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 10px; color: var(--muted); font-size: 0.76rem; }
</style>
